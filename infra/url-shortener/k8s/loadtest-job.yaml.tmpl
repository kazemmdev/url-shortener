apiVersion: batch/v1
kind: Job
metadata:
  name: k6-${TARGET_SERVICE}-${RUN_ID}
  namespace: url-shortener
  labels: { app: k6-loadtest, target: "${TARGET_SERVICE}" }
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels: { app: k6-loadtest }
    spec:
      restartPolicy: Never
      containers:
        - name: k6
          image: grafana/k6:latest
          args: ["run", "/scripts/url-shortener.js"]
          env:
            - name: BASE_URL
              value: "http://${TARGET_SERVICE}:8080"
            - name: PROFILE
              value: "${PROFILE}"
            - name: TARGET_RPS
              value: "${TARGET_RPS}"
            - name: WRITE_PERCENT
              value: "${WRITE_PERCENT}"
          volumeMounts:
            - name: script
              mountPath: /scripts
              readOnly: true
      volumes:
        - name: script
          configMap: { name: k6-script }
