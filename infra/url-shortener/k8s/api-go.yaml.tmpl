# Same shape as api.yaml.tmpl, for the Go implementation, so the two can be
# compared under identical resource ceilings:
#   API_CPUS=0.5 API_MEMORY=256Mi ./deploy-api-go.sh
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api-go
  namespace: url-shortener
spec:
  replicas: ${API_REPLICAS}
  selector:
    matchLabels: { app: api-go }
  template:
    metadata:
      labels: { app: api-go }
    spec:
      containers:
        - name: api-go
          image: ${API_IMAGE}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8080
          env:
            - name: HTTP_PORT
              value: "8080"
            - name: SQLSERVER_HOST
              value: "sqlserver"
            - name: SQLSERVER_PORT
              value: "1433"
            - name: SQLSERVER_USER
              value: "sa"
            - name: SQLSERVER_DATABASE
              value: "UrlShortener"
            - name: SQLSERVER_PASSWORD
              valueFrom:
                secretKeyRef: { name: url-shortener-secrets, key: MSSQL_SA_PASSWORD }
            - name: REDIS_ADDR
              value: "redis:6379"
            - name: EXPIRE_DAYS
              value: "30"
          resources:
            requests:
              cpu: "${API_CPUS_REQUEST}"
              memory: "${API_MEMORY_REQUEST}"
            limits:
              cpu: "${API_CPUS}"
              memory: "${API_MEMORY}"
          readinessProbe:
            tcpSocket: { port: 8080 }
            initialDelaySeconds: 3
            periodSeconds: 5
          livenessProbe:
            tcpSocket: { port: 8080 }
            initialDelaySeconds: 10
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: api-go
  namespace: url-shortener
spec:
  selector: { app: api-go }
  ports:
    - port: 8080
      targetPort: 8080
